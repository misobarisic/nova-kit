// Minimal host contract. Nova supplies these through its compiled NovaUiShared library.
export { Theme, ThemePalette } from "theme.slint";
export { Anim } from "anim.slint";
export { SettingSyncInfo } from "sync-types.slint";

export global InterfaceStyle {
    in-out property <bool> tv: false;
}

export global SettingsStyle {
    in-out property <bool> keyboard-mode: false;
    in-out property <length> focus-y;
    in-out property <length> focus-height;
    in-out property <bool> navigation-focus: false;
    in-out property <int> focus-request: 0;

    public function reveal_control(y: length, height: length, navigation: bool) {
        self.focus-y = y;
        self.focus-height = height;
        self.navigation-focus = navigation;
        self.focus-request += 1;
    }
}

// Settings search for rows. A host without it keeps `enabled` false and rows
// draw no highlight overlay.
export global SettingsHighlight {
    out property <bool> enabled: false;
    out property <bool> pending: false;
    pure public function is-target(key: string) -> bool { false }
    public function reveal(y: length, height: length) { }
}

export global ControlInput {
    in-out property <bool> touch-feedback: false;
}

export global SliderGesture {
    in-out property <bool> active: false;
    in-out property <bool> hovered: false;
}

export struct SheetItem { label: string, enabled: bool }
