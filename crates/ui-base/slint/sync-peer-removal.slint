import { Theme, SettingsStyle } from "@NovaUiShared";
import { SyncBridge, SyncContent } from "@NovaSyncHost";
import { PillButton } from "settings-controls.slint";
import { ScrollView } from "scrollview.slint";

export component SyncPeerRemovalModal inherits Rectangle {
    in property <bool> active: true;
    in property <length> safe-top;
    in property <length> safe-bottom;
    in property <length> safe-left;
    in property <length> safe-right;
    callback closed();
    visible: SyncContent.sync_remove_prompt_visible && root.active;
    function cancel() {
        SyncContent.sync_remove_prompt_visible = false;
        SyncContent.sync_remove_prompt_id = "";
        SyncContent.sync_remove_prompt_name = "";
        root.closed();
    }
    function confirm() {
        let id = SyncContent.sync_remove_prompt_id;
        root.cancel();
        if id != "" { SyncBridge.sync_remove_peer(id); }
    }
    if SyncContent.sync_remove_prompt_visible && root.active: remove_modal := Rectangle {
        width: 100%; height: 100%;
        background: Theme.current.scrim_settings;
        property <int> action: 0;
        modal_focus := FocusScope {
            width: 100%; height: 100%;
            init => { self.focus(); }
            key-pressed(e) => {
                if e.text == Key.Escape || e.text == Key.Back || e.text == Key.Backspace {
                    if !e.repeat { root.cancel(); }
                    accept
                } else if e.text == Key.Return || e.text == " " {
                    if !e.repeat {
                        if remove_modal.action == 0 { root.cancel(); }
                        else { root.confirm(); }
                    }
                    accept
                } else if e.text == Key.LeftArrow || e.text == Key.UpArrow {
                    remove_modal.action = 0; accept
                } else if e.text == Key.RightArrow || e.text == Key.DownArrow {
                    remove_modal.action = 1; accept
                } else if e.text == Key.Tab {
                    remove_modal.action = 1 - remove_modal.action; accept
                } else { accept }
            }
        }
        TouchArea {
            width: 100%; height: 100%;
            clicked => { root.cancel(); }
            scroll-event(event) => { accept }
        }
        sync_remove_panel := Rectangle {
            width: Math.max(1px, Math.min(480px, root.width - 0px - root.safe-left - root.safe-right - 32px));
            height: Math.max(1px, Math.min(remove_content.preferred-height, root.height - root.safe-top - root.safe-bottom - 32px));
            x: 0px + root.safe-left + (root.width - 0px - root.safe-left - root.safe-right - self.width) / 2;
            y: root.safe-top + (root.height - root.safe-top - root.safe-bottom - self.height) / 2;
            background: Theme.current.removal_prompt;
            border-radius: 16px; border-width: 1px;
            border-color: Theme.current.removal_border;
            clip: true;
            TouchArea { width: 100%; height: 100%; }
            remove_content := VerticalLayout {
                width: 100%; height: 100%; padding: 16px; spacing: 12px;
                Text {
                    text: @tr("Remove device?"); font-size: 16px; font-weight: 700;
                    color: Theme.current.text_bright; wrap: word-wrap;
                    min-width: 0px; vertical-stretch: 0;
                }
                remove_message_scroll := ScrollView {
                    min-height: 0px; vertical-stretch: 1;
                    preferred-height: remove_message.preferred-height;
                    content-width: self.visible-width;
                    content-height: remove_message.preferred-height;
                    remove_message := Text {
                        width: remove_message_scroll.visible-width; height: self.preferred-height;
                        text: @tr("{} will be removed from sync on every paired device.", SyncContent.sync_remove_prompt_name);
                        color: Theme.current.text_settings; font-size: 14px;
                        wrap: char-wrap; min-width: 0px;
                    }
                }
                HorizontalLayout {
                    spacing: 12px; vertical-stretch: 0;
                    sync_remove_cancel := PillButton {
                        label: @tr("Cancel"); roomy: true;
                        focused: SettingsStyle.keyboard-mode && remove_modal.action == 0;
                        clicked => { root.cancel(); }
                    }
                    sync_remove_confirm := PillButton {
                        label: @tr("Remove"); roomy: true; destructive: true; primary: true;
                        focused: SettingsStyle.keyboard-mode && remove_modal.action == 1;
                        clicked => { root.confirm(); }
                    }
                }
            }
        }
    }
}
